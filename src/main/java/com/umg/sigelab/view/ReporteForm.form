<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.umg.sigelab.view.ReporteForm">
  <grid id="r0001" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="5" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="900" height="520"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="r0002" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Reporte:"/>
        </properties>
      </component>
      <component id="r0003" class="javax.swing.JComboBox" binding="cmbReporte">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="r0004" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Desde (dd/MM/aaaa):"/>
        </properties>
      </component>
      <component id="r0005" class="javax.swing.JTextField" binding="txtDesde">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="120" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="r0006" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Hasta (dd/MM/aaaa):"/>
        </properties>
      </component>
      <component id="r0007" class="javax.swing.JTextField" binding="txtHasta">
        <constraints>
          <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="120" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="r0008" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Código de equipo:"/>
        </properties>
      </component>
      <component id="r0009" class="javax.swing.JTextField" binding="txtCodigo">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="120" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="r0010" class="javax.swing.JButton" binding="btnConsultar">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Consultar"/>
        </properties>
      </component>
      <component id="r0011" class="javax.swing.JButton" binding="btnLimpiar">
        <constraints>
          <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Limpiar"/>
        </properties>
      </component>
      <scrollpane id="r0012">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="4" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="r0013" class="javax.swing.JTable" binding="tblResultados">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="r0014" class="javax.swing.JLabel" binding="lblTotal">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Registros: 0"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
